<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.8.xsd">

    <changeSet id="1" author="rosti">
        <createTable tableName="users_data_table">
            <column name="chat_id" type="BIGINT">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="telegram_id" type="BIGINT"/>
            <column name="registered_at" type="datetime(6)"/>
            <column name="first_name" type="VARCHAR(255)"/>
            <column name="last_name" type="VARCHAR(255)"/>
            <column name="user_name" type="VARCHAR(255)"/>
            <column name="role" type="VARCHAR(20)"/>
            <column name="language_code" type="VARCHAR(255)"/>
            <column name="phone_number" type="VARCHAR(255)"/>
            <column name="discount" type="INT" defaultValueNumeric="0"/>
            <column name="ai_message_count" type="INT" defaultValueNumeric="0"/>
            <column name="first_ai_message_date" type="DATE"/>
        </createTable>
    </changeSet>

    <changeSet id="2" author="rosti">
        <createTable tableName="chat_history">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_chatHistory_user" references="users_data_table(chat_id)"/>
            </column>
            <column name="role" type="TEXT"/>
            <column name="message" type="TEXT"/>
            <column name="timestamp" type="datetime(6)"/>
            <column name="username" type="VARCHAR(255)"/>
        </createTable>
    </changeSet>

    <changeSet id="3" author="rosti">
        <createTable tableName="files">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="file_name" type="VARCHAR(255)"/>
            <column name="file_type" type="VARCHAR(255)"/>
            <column name="file_size" type="BIGINT"/>
            <column name="file_group" type="VARCHAR(255)"/>
            <column name="file_data" type="LONGBLOB"/>
            <column name="uploaded_by" type="BIGINT"/>
            <column name="uploaded_at" type="datetime(6)"/>
        </createTable>
    </changeSet>

    <changeSet id="4" author="rosti">
        <createTable tableName="user_activity">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false" />
            </column>
            <column name="first_daily_use" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="first_weekly_use" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="first_monthly_use" type="DATE">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>